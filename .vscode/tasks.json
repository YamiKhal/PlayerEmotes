{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PlayerEmotes: launch",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/dev.ps1", "-Target", "${input:target}", "-Mode", "${input:mode}"],
      "problemMatcher": []
    },
    {
      "label": "PlayerEmotes: build all versions",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew.bat",
      "args": ["buildAndCollect", "--continue"],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Tools: download YouTube videos",
      "type": "process",
      "command": "py",
      "args": ["-3", "${workspaceFolder}/tools/youtube/download.py"],
      "options": {"cwd": "${workspaceFolder}/tools/youtube"},
      "presentation": {"focus": true, "panel": "dedicated", "clear": true},
      "problemMatcher": []
    },
    {
      "label": "Tools: convert video to emote",
      "type": "process",
      "command": "py",
      "args": ["-3", "${workspaceFolder}/tools/video/video2emote.py"],
      "options": {"cwd": "${workspaceFolder}/tools/video"},
      "presentation": {"focus": true, "panel": "dedicated", "clear": true},
      "problemMatcher": []
    },
    {
      "label": "Tools: convert AIST++ dance to emote",
      "type": "process",
      "command": "py",
      "args": ["-3", "${workspaceFolder}/tools/video/aist.py"],
      "options": {"cwd": "${workspaceFolder}/tools/video"},
      "presentation": {"focus": true, "panel": "dedicated", "clear": true},
      "problemMatcher": []
    },
    {
      "label": "Tools: preview animation",
      "type": "process",
      "command": "py",
      "args": ["-3", "${workspaceFolder}/tools/video/preview.py"],
      "options": {"cwd": "${workspaceFolder}/tools/video"},
      "presentation": {"focus": true, "panel": "dedicated", "clear": true},
      "problemMatcher": []
    },
    {
      "label": "Tools: polish animation",
      "type": "process",
      "command": "py",
      "args": ["-3", "${workspaceFolder}/tools/video/polish.py"],
      "options": {"cwd": "${workspaceFolder}/tools/video"},
      "presentation": {"focus": true, "panel": "dedicated", "clear": true},
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "target",
      "type": "pickString",
      "description": "Minecraft version and loader (keep in sync with settings.gradle.kts)",
      "options": ["1.20.1-fabric", "1.20.1-forge", "1.21.1-fabric", "1.21.1-neoforge", "1.21.1-forge", "1.21.4-fabric", "1.21.4-neoforge", "1.21.4-forge", "1.21.11-fabric", "1.21.11-neoforge", "1.21.11-forge", "26.1.2-fabric", "26.1.2-neoforge", "26.3-fabric", "26.3-neoforge"],
      "default": "1.21.1-fabric"
    },
    {
      "id": "mode",
      "type": "pickString",
      "description": "What to launch",
      "options": ["client", "mp", "server", "clients", "showcase"],
      "default": "client"
    }
  ]
}
